# Public site URL used for metadata, canonical URLs, and sitemap
NEXT_PUBLIC_SITE_URL=https://jsk-hr-consulting.vercel.app

# Verified recipient for consultation enquiries
CONTACT_TO_EMAIL=

# Resend API key for email delivery
RESEND_API_KEY=

# Optional verified sender identity for Resend
CONTACT_FROM_EMAIL=JSK Website <onboarding@resend.dev>

# Must be explicitly set to "true" before live enquiries are accepted
CONTACT_ACCEPT_ENQUIRIES=false

# Optional Calendly URL
NEXT_PUBLIC_CALENDLY_URL=
