# Public site URL used for metadata, canonical URLs, and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified recipient for consultation enquiries (do not invent a business email)
CONTACT_TO_EMAIL=

# Resend API key for email delivery
RESEND_API_KEY=

# Optional verified sender identity for Resend
CONTACT_FROM_EMAIL=JSK Website <onboarding@resend.dev>

# Optional Calendly URL — leave blank until a real booking link is provided
NEXT_PUBLIC_CALENDLY_URL=
